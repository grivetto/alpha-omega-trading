# Alpha-Omega Trading Environment Configuration
# Copy to .env and fill in your values

# Exchange API Keys (REQUIRED)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Trading Mode
LIVE_MODE=0  # Set to 1 for live trading

# Bot Configuration
EXCHANGE=kraken
SYMBOL=DOGE/EUR
CAPITAL=50
HEALTH_PORT=8911

# Strategy
GRID_LEVELS=5
BASE_SPREAD_PCT=0.5
PER_LEVEL=0.2

# Risk
USE_MOMENTUM_FILTER=1
MAX_DRAWDOWN_PCT=0.15
MAX_DAILY_LOSS_PCT=0.05
HYBRID_MODE=0
RISK_MANAGER_ENABLED=1
MAX_PORTFOLIO_DD=0.20
MAX_EXPOSURE_PER_BASE=0.30
MAX_CORRELATION=0.7
MAX_POSITIONS_PER_BASE=2
VOLATILITY_TARGETING=1

# Network
ZMQ_PUB_PORT=5555
ZMQ_SUB_PORT=5555
REDIS_URL=redis://localhost:6379

# Storage
DB_PATH=denaro_neo.db
STATE_FILE=/tmp/shadowgrid_state.json
LOG_FILE=/tmp/shadowgrid.log
LOG_LEVEL=INFO

# Alerts
ALERT_ENABLED=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
