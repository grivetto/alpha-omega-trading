[Unit]
Description=Alpha-Omega Fleet Coordinator
After=network-online.target redis.service postgresql.service
Wants=network-online.target redis.service postgresql.service

[Service]
Type=simple
User=alphaomega
Group=alphaomega
WorkingDirectory=/opt/alpha-omega-trading
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/alpha-omega-trading
ExecStart=/opt/alpha-omega-trading/venv/bin/python -m alpha_omega.fleet.coordinator --config /opt/alpha-omega-trading/config/fleet_config_nuvola.json
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/alpha-omega-trading /tmp

[Install]
WantedBy=multi-user.target
