[Unit]
Description=Alpha-Omega SOLO Engine v3.3 consolidato (OKX EEA Grid - SOL/EUR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/marco/denaro/venv/bin/python /home/marco/denaro/engine_solo_v33.py --exchange okx --symbol SOL/EUR --capital 5.0 --profit-target 1.5 --buy-distance 1.0 --grid-levels 3 --loop --interval 60
WorkingDirectory=/home/marco/denaro
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
EnvironmentFile=/home/marco/denaro/.env

[Install]
WantedBy=default.target
