[Unit]
Description=Denaro — OKX Grid SOL/EUR (conto main, MARCODG1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marco
ExecStart=/home/marco/denaro/venv/bin/python /home/marco/denaro/engine_solo_v33.py --exchange okx --symbol SOL/EUR --capital 5.0 --profit-target 1.5 --buy-distance 1.0 --grid-levels 3 --loop --interval 60 --health-file /home/marco/denaro/health/sol.json
WorkingDirectory=/home/marco/denaro
EnvironmentFile=/home/marco/denaro/.env
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
