[Unit]
Description=Denaro Node — TRADING MARCODG1 (OKX marcosub1, mean-reversion XRP/EUR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marco
WorkingDirectory=/home/marco/alpha-omega-trading
EnvironmentFile=/home/marco/alpha-omega-trading/config/.env_marcodg1
ExecStart=/home/marco/alpha-omega-trading/venv/bin/python -m denaro.denaro_node --config config/node_marcodg1_xrp.yaml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
