[Unit]
Description=Alpha-Omega SOLO Engine v3.3 (OKX EEA Grid - ADA/EUR, conto alpha)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/marco/denaro/venv/bin/python /home/marco/denaro/engine_solo_v33.py --exchange okx --symbol ADA/EUR --capital 20.0 --profit-target 2.0 --buy-distance 1.5 --grid-levels 3 --loop --interval 60
WorkingDirectory=/home/marco/alpha-omega-trading
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
EnvironmentFile=/home/marco/alpha-omega-trading/.env

[Install]
WantedBy=default.target
