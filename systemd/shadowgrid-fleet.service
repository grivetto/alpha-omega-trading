[Unit]
Description=Alpha-Omega ShadowGrid Fleet Orchestrator (Multi-Bot)
After=network-online.target redis.service
Wants=network-online.target redis.service

[Service]
Type=simple
ExecStart=%h/denaro/venv/bin/python -m alpha_omega.fleet.coordinator --config %h/denaro/config/fleet_config.json
WorkingDirectory=%h/denaro
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/denaro

# Resource limits
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=default.target
