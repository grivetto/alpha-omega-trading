[Unit]
Description=Zabbix tunnel nuvola -> MARCODG1 (10051, poi verso mc2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sergio
ExecStart=/usr/bin/autossh -M 0 -N -o "ServerAliveInterval 30" -o "ServerAliveCountMax 3" -o "ExitOnForwardFailure yes" -L 10051:127.0.0.1:10051 MARCODG1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
