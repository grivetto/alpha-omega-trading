[Unit]
Description=Denaro Node — trading engine unificato su MC2 (live OKX mc2sub1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/sergio/alpha-omega-trading/venv/bin/python -m denaro.denaro_node --config config/node_mc2.yaml
WorkingDirectory=/home/sergio/alpha-omega-trading
EnvironmentFile=/home/sergio/alpha-omega-trading/config/.env_mc2
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
