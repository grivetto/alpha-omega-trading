[Unit]
Description=Denaro — OKX Grid ADA/EUR (conto marcosub1, MARCODG1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marco
ExecStart=/home/marco/denaro/venv/bin/python /home/marco/denaro/engine_solo_v33.py --exchange okx --symbol ADA/EUR --capital 20.0 --profit-target 2.0 --buy-distance 0.1 --grid-levels 3 --loop --interval 60 --health-file /home/marco/denaro/health/ada.json
WorkingDirectory=/home/marco/alpha-omega-trading
EnvironmentFile=/home/marco/alpha-omega-trading/.env
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
