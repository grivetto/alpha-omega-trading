# Denaro - Infra Aggregator mc2 (:8912)
# Alimenta la dashboard (:8913) e /api/infra.json pubblico via cloudflared.
#
# ExecStartPre: port_guard.sh termina le copie ESTRANEE dell'aggregator (avviate
# a mano) che tengono la 127.0.0.1:8912.
# Incident 2026-09-10: un aggregator manuale teneva la porta -> restart-loop
# (17 restart) con "Errno 98 Address already in use" -> dashboard senza dati.
# StartLimit* rende VISIBILE un crash-loop persistente invece di farlo girare
# per ore in silenzio.
[Unit]
Description=Denaro - Infra Aggregator mc2 (:8912, alimenta dashboard)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sergio
WorkingDirectory=/home/sergio/alpha-omega-trading
ExecStartPre=/bin/bash /home/sergio/alpha-omega-trading/denaro/scripts/port_guard.sh denaro-aggregator-mc2.service infra_aggregator.py 8912
ExecStart=/usr/bin/python3 /home/sergio/alpha-omega-trading/denaro/infra_aggregator.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
