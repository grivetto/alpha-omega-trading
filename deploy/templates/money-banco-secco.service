[Unit]
Description=Money — Banco di prova a secco (pre-produzione)
Documentation=https://github.com/grivetto/money/blob/main/docs/02_banco_di_prova_a_secco.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{PROJECT_ROOT}}/deploy/scripts/money_banco_secco.sh
WorkingDirectory={{PROJECT_ROOT}}
EnvironmentFile={{PROJECT_ROOT}}/config/.env_banco
StandardOutput=journal
StandardError=journal
User=sergio
Group=sergio

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{PROJECT_ROOT}}/logs {{PROJECT_ROOT}}/data
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target