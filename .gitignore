# ─────────────────────────────────────────────────────────────
# Denaro / Alpha-Omega — .gitignore
# Regola: nel repo entra SOLO codice e configurazione. Mai stato,
# segreti, log, backup o artefatti di run.
# ─────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# Virtual environments
venv/
env/
.venv/

# ── Segreti: MAI committare ──
.env
.env.*
!.env.example
.denaro_vault/
keys_master.env
*_API_KEY=
*_API_SECRET=
*_PASSPHRASE=

# ── Stato di esecuzione (rigenerabile, specifico della macchina) ──
node_data/
node_data_*/
paper_state/
health/*.json
!health/.gitkeep
*.sqlite
*.sqlite3
*.db

# ── Log e output ──
*.log
*.out
logs/

# ── Backup: qualunque variante ──
*.bak
*.bak.*
*.bak-*
*.backup
*.orig
*~

# ── IDE / OS ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Test / coverage ──
.coverage
htmlcov/
.pytest_cache/
.abtest/
.pytmp/

# ── Tooling agenti (config locali, non fanno parte del progetto) ──
.deepseek/
.dsh_push/
.dsh_*
hermes-moa-free-presets.yaml

# ── File temporanei di diagnostica/operativi ──
# NOTA: non usare `_*.py` — ignorerebbe anche i __init__.py del package
_*.sh
_*.bat
_*.md
_*.tmp.py
_*.bak.py

# ── Cache dati di mercato e output dei backtest (rigenerabili) ──
backtest_data/
backtest_out/

# ── Artefatti di orchestrazione legacy ──
orchestration/
orchestration*.json*
comunicazione_ai/
deepseek_*.json*
deploy_decisions_*.json
fase*.json*
strategies/*.json
*.sql.gz
