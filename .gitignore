# ─────────────────────────────────────────────────────────────
# Denaro / Alpha-Omega — .gitignore
# Regola: nel repo entra SOLO codice e configurazione. Mai stato,
# segreti, log, backup o artefatti di run.
# ─────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# Virtual environments
venv/
env/
.venv/

# ── Segreti: MAI committare ──
.env
.env.*
!.env.example
.denaro_vault/
keys_master.env
*_API_KEY=
*_API_SECRET=
*_PASSPHRASE=

# ── Stato di esecuzione (rigenerabile, specifico della macchina) ──
node_data/
node_data_*/
paper_state/
health/*.json
!health/.gitkeep
*.sqlite
*.sqlite3
*.db

# ── Log e output ──
*.log
*.out
logs/

# ── Backup: qualunque variante ──
*.bak
*.bak.*
*.bak-*
*.backup
*.orig
*~

# ── IDE / OS ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Test / coverage ──
.coverage
htmlcov/
.pytest_cache/
.abtest/
.pytmp/

# ── Tooling agenti (config locali, non fanno parte del progetto) ──
.deepseek/
.dsh_push/
.dsh_*
hermes-moa-free-presets.yaml

# ── Ponte AI / orchestratori LLM: fuori dal prodotto di trading ──
# (documenti e script sul bridge Hermes/DeepSeek: non riguardano il motore)
docs/*hermes*
docs/*ponte*
docs/*moa*
scripts/hermes_moa_anti_refusal.py
scripts/patch_moa_aggregator.py
scripts/stella_bridge.py

# ── File temporanei di diagnostica/operativi ──
# NOTA: non usare `_*.py` — ignorerebbe anche i __init__.py del package
_*.sh
_*.bat
_*.md
_*.tmp.py
_*.bak.py

# ── Cache dati di mercato e output dei backtest (rigenerabili) ──
backtest_data/
backtest_out/

# ── Artefatti di orchestrazione legacy ──
orchestration/
orchestration*.json*
comunicazione_ai/
deepseek_*.json*
deploy_decisions_*.json
fase*.json*
strategies/*.json
*.sql.gz

# ── Segreti: varianti senza punto (config/.env_nuvola) ──
# Regola 2026-09-17: il pattern .env.* NON copriva .env_nuvola. Quel file
# conteneva chiavi OKX live ed era untracked-ma-non-ignorato: un "git add -A"
# lo avrebbe committato. Non e' mai finito nella storia, ma la falla va chiusa.
.env_*
*.env_*

# ── Artefatti generati (2026-09-17) ──
# Il brain genera centinaia di strategie e dataset: sono materiale di ricerca
# rigenerabile, non codice. Restano su disco, non nel repo.
strategies/auto_gen_*.py
strategies/*_prices.txt
strategies/_last_gen.txt
strategies/test_*.py
brain/data/
legacy/
.codewhale/
fase1_reply_*.txt
_last_gen.txt

# La dir health DENTRO denaro/ e' scritta dal cron dell'aggregator
# (snapshot ogni minuto). Il pattern health/*.json qui sopra e' ancorato
# alla radice: non la copriva, e il file finiva tracciato.
denaro/health/

# Dato della scommessa: generato dal cron su MARCODG1 (tools/scommessa.py),
# non e' codice — mai nel repo.
denaro/scommessa.json*

# cartella morta rimossa: se ricreata non deve finire in git
_dead/

# ── Chiavi Bybit EU (2026-09-18) ──
# ".bybit.env" NON era coperto: ".env.*" vuole il prefisso ".env." e ".env_*" vuole
# un underscore finale. I file reali stanno fuori dal repo (/home/sergio/denaro/),
# ma la regola serve: un "git add -A" da una copia di lavoro li committerebbe.
.bybit.env
.bybit.env.*
*.bybit.env
new-api-bybit
new-api-bybit.*
*-api-keys
*-api-keys.*
*.keys.env
secrets/
