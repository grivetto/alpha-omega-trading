# Airdrop Farm - Environment Variables
# Copy to .env and fill in your values

# BIP39 mnemonic (20 wallets derived from single seed)
MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"

# Fernet encryption key for wallet vault (generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Exchange APIs (for MEXC launchpad, optional)
MEXC_API_KEY=
MEXC_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# RPC overrides (optional, defaults in config.yaml)
BASE_RPC=https://mainnet.base.org
SCROLL_RPC=https://rpc.scroll.io
ABSTRACT_RPC=https://api.mainnet.abs.xyz
LINEA_RPC=https://rpc.linea.build
MONAD_RPC=https://rpc.monad.xyz
HYPERLIQUID_API=https://api.hyperliquid.xyz