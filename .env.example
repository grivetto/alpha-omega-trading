# ATLAS Trading Bot - Environment Variables
# Copy to .env and fill in your API keys

# Environment
ATLAS_ENV=development
ATLAS_LOG_LEVEL=INFO
ATLAS_LOG_JSON=true
ATLAS_TIMEZONE=UTC
ATLAS_HEALTH_PORT=8080

# Kraken (EUR pairs)
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# OKX (USDT pairs)
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# Database (SQLite for development)
ATLAS_DATABASE_URL=sqlite+aiosqlite:///./atlas.db

# Redis (for idempotency keys, caching)
ATLAS_REDIS_URL=redis://localhost:6379/0

# Paper trading mode (true for testing, false for live)
ATLAS_PAPER_MODE=true
