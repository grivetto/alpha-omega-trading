# Denaro v5 — Environment Configuration
#
# Copy to .env and fill in your real values.
# NEVER commit .env to git.

# === Kraken API (required - nuvola LIVE) ===
# Create API key at Kraken: Settings > API > Generate Key
# Enable: Query Funds, Create/Modify Orders, Cancel Orders
KRAKEN_API=your_api_key_here
KRAKEN_SECRET=your_api_secret_here

# === MEXC API (required - for MEXC operations) ===
# Create at MEXC: API Management → Create API
# Permissions: Read, Spot Trading ✓, Withdrawal ✗
# IP Whitelist: 87.106.3.15 (nuvola), 87.106.222.123 (MARCODG1)
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_api_secret_here

# === Trading Parameters (Kraken DOGE/EUR) ===
SYMBOL=DOGE/EUR                        # Trading pair (Kraken spot)
CAPITAL=100.0                          # Per-machine EUR capital
LEVELS=5                               # Grid levels (1-20)
SPREAD=0.025                           # Base spread (2.5%)
TAKE_PROFIT=0.03                       # Take-profit per level (3%)
COOLDOWN=30                            # Seconds between cycles (5-300)
MAX_DEPLOYED=0.50                      # Max 50% of equity in grid at once
MIN_ORDER_EUR=1.0                      # Kraken min notional ~1 EUR

# === Mode ===
# SHADOW_MODE=1  → simulated trading at SHADOW_FACTOR (safe, default)
# SHADOW_MODE=0  → live trading
SHADOW_MODE=1
SHADOW_FACTOR=0.10                     # 10% of normal position size

# MOCK_MODE=1    → use MockKrakenEngine (no API keys needed, local sim)
MOCK_MODE=0

# === Risk Management ===
MAX_DAILY_LOSS_PCT=2.0                # % daily loss before circuit breaker
MAX_DRAWDOWN_PCT=5.0                  # % drawdown from peak before CB
MAX_CONSECUTIVE_LOSSES=4              # Max losing trades before CB
COMPOUND_RATIO=0.5                    # 50% of profits reinvested

# === Performance (v5) ===
BALANCE_CACHE_TTL=15                  # Balance cache TTL in seconds (default: 15)
ORDERS_CACHE_TTL=10                   # Open orders cache TTL in seconds (default: 10)

# === Lockout Protection (v5) ===
LOCKOUT_BACKOFF_MIN=30                # Initial backoff in seconds on lockout
LOCKOUT_BACKOFF_MAX=600               # Maximum backoff (10 min)

# === Recovery (v5) ===
LOCKOUT_RETRY_INTERVAL=60             # Check Kraken availability every 60s
DEEP_SLEEP_CYCLES=5                   # Enter deep sleep after N failed cycles
STATE_SAVE_INTERVAL=30                # Min seconds between state file writes

# === Telegram Alerts (REQUIRED for production) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Health Server ===
HEALTH_PORT=8909

# === WebSocket ===
KRAKEN_WS_DISABLE=0

# === Logging ===
LOG_LEVEL=INFO