# Denaro Trading System — Environment Configuration
#
# Copy to .env and fill in your real values.
# NEVER commit .env to git.

# === Kraken API (required) ===
# Create API key at Kraken: Settings > API > Generate Key
# Enable: Query Funds, Create/Modify Orders, Cancel Orders
KRANKEN_API_KEY=your_api_key_here
KRANKEN_API_SECRET=your_api_secret_here

# === Trading Parameters ===
SYMBOL=DOGE/EUR                        # Trading pair (Kraken spot)
CAPITAL=100.0                          # Per-machine EUR capital
LEVELS=5                               # Grid levels (1-20)
SPREAD=0.025                           # Base spread (2.5%)
TAKE_PROFIT=0.03                       # Take-profit per level (3%)
COOLDOWN=30                            # Seconds between cycles (5-300)

# === Mode ===
# SHADOW_MODE=1  → simulated trading at SHADOW_FACTOR (safe, default)
# SHADOW_MODE=0  → live trading
SHADOW_MODE=1
SHADOW_FACTOR=0.10                     # 10% of normal position size

# DRY_RUN=1      → orders logged but not sent to Kraken
DRY_RUN=0

# MOCK_MODE=1    → use MockKrakenEngine (no API keys needed, local sim)
MOCK_MODE=0

# === Risk Management ===
MAX_DAILY_LOSS_PCT=5.0                # % daily loss before circuit breaker
MAX_DRAWDOWN_PCT=2.0                  # % drawdown from peak before CB
MAX_CONSECUTIVE_LOSSES=4              # Max losing trades before CB
COMPOUND_RATIO=0.5                    # 50% of profits reinvested

# === Telegram Alerts (optional but recommended) ===
# 1. Create a bot via @BotFather on Telegram
# 2. Get your chat ID from @userinfobot or @RawDataBot
# Without these, notifications go to log only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Health Server (optional) ===
# Lightweight HTTP server for systemd HEALTHCHECK and monitoring.
# Access: http://127.0.0.1:8909/health  /metrics  /status
HEALTH_PORT=8909

# === WebSocket (optional, default: enabled) ===
# WebSocket provides real-time price feed from Kraken.
# Disable if you encounter WS issues (falls back to REST polling).
KRAKEN_WS_DISABLE=0

# === Logging ===
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR
# LOG_FILE defaults to kraken_bot.log in the same directory
# STATE_FILE defaults to denaro_core_state.json
# Core state stored in ~/.local/share/denaro/denaro_core_state.json
