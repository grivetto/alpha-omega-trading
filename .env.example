# Denaro Trading System — Environment Configuration
#
# Copy to .env and fill in your real values.
# NEVER commit .env to git.

# === Binance API (required) ===
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# === Trading Parameters ===
TRADING_SYMBOL=SOL/USDC
TOTAL_CAPITAL_USDC=200
GRID_LEVELS=4
GRID_SPACING_PCT=0.012
MIN_ORDER_USDC=5.1
STOP_LOSS_TYPE=atr
STOP_LOSS_ATR_MULT=1.5

# === Risk Management ===
MAX_DAILY_LOSS_PCT=3.0
CIRCUIT_BREAKER_PCT=5.0
KELLY_FRACTION=0.5
MAX_CONSECUTIVE_LOSSES=3

# === Observability ===
HEALTH_PORT=8909
TELEGRAM_ALERTS=false
LOG_LEVEL=INFO
DRY_RUN=false

# === LLM (optional) ===
LLM_ENDPOINT=http://192.168.1.100:11434/v1
LLM_MODEL=qwen3.5:4b
