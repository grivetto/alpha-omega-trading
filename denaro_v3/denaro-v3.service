[Unit]
Description=Denaro v3 Trading Engine
After=network.target

[Service]
Type=simple
User=sergio
EnvironmentFile=/home/sergio/denaro/.env
Environment=MACHINE_ID=mc2
WorkingDirectory=/home/sergio/denaro/denaro_v3
ExecStart=/home/sergio/denaro/venv/bin/python3 -u main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
