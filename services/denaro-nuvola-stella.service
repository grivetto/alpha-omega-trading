[Unit]
Description=Denaro Nuvola Stella Grid SOL/USDC
After=network.target

[Service]
Type=simple
User=sergio
WorkingDirectory=/home/sergio/denaro
ExecStart=/home/sergio/denaro/venv/bin/python3 -u /home/sergio/denaro/stella_grid.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
