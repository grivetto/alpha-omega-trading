[Unit]
Description=Denaro MC2 Triangular Arbitrage Bot
After=network.target
Wants=denaro-mc2-grid.service

[Service]
Type=simple
User=sergio
WorkingDirectory=/home/sergio/denaro
ExecStart=/home/sergio/denaro/venv/bin/python3 -u /home/sergio/denaro/arb_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
