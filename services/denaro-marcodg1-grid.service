[Unit]
Description=Denaro MARCODG1 ADA/USDC Grid Bot
After=network.target

[Service]
Type=simple
User=marco
WorkingDirectory=/home/marco/denaro
ExecStart=/home/marco/denaro/venv/bin/python3 -u /home/marco/denaro/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
