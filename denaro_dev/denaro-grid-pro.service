[Unit]
Description=Denaro GRID-PRO: Production grid bot on MARCODG1
After=network-online.target

[Service]
Type=simple
User=marco
WorkingDirectory=/home/marco/denaro_dev
EnvironmentFile=/home/marco/denaro_dev/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u grid_pro.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
