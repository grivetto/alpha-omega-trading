[Unit]
Description=Denaro Dev — Grid+ATR strategy testbed
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marco
WorkingDirectory=/home/marco/denaro_dev
EnvironmentFile=/home/marco/denaro_dev/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
