[Unit]
Description=Denaro ADVISOR: Trend signal for GRID-PRO
After=network-online.target

[Service]
Type=simple
User=marco
WorkingDirectory=/home/marco/denaro_dev
EnvironmentFile=/home/marco/denaro_dev/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u advisor.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
