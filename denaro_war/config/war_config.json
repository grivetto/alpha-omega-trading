{
  "_comment": "Denaro War Machine - Production Config",
  "version": "5.0.0",

  "total_capital": 251.0,
  "initial_capital": 251.0,
  "base_currency": "USDC",
  "max_risk_per_trade": 0.05,
  "max_daily_loss": 0.15,
  "max_drawdown": 0.25,

  "exchanges": {
    "binance": {
      "api_key": "",
      "api_secret": "",
      "base_url": "https://api.binance.com",
      "ws_url": "wss://stream.binance.com:9443/ws",
      "testnet": false,
      "rate_limit_per_second": 10
    }
  },

  "symbols": [
    "SOLUSDC",
    "ADAUSDC",
    "DOGEUSDC"
  ],

  "orchestrator": {
    "check_interval_ms": 100,
    "health_check_interval_s": 30,
    "circuit_breaker_threshold": 5,
    "circuit_breaker_cooldown_s": 120,
    "heartbeat_interval_s": 10,
    "graceful_shutdown_timeout_s": 5
  },

  "capital_allocator": {
    "rebalance_interval_s": 300,
    "min_allocation_per_strategy": 5.0,
    "max_allocation_per_strategy": 0.60,
    "performance_window_minutes": 60,
    "sharpe_threshold_baseline": 1.0,
    "allocation_decay_factor": 0.7,
    "strategy_pool": ["scalper", "whale_tracker", "news_reactor"]
  },

  "scalper": {
    "enabled": true,
    "min_capital": 5.0,
    "max_capital_pct": 0.60,
    "atr_period": 14,
    "atr_baseline_periods": 50,
    "atr_spike_threshold": 3.0,
    "atr_lookback_for_baseline": 100,
    "entry_consecutive_spikes": 2,
    "take_profit_atr_multiple": 1.5,
    "stop_loss_atr_multiple": 1.0,
    "max_hold_seconds": 120,
    "min_hold_seconds": 10,
    "min_profit_bps": 5,
    "max_positions_per_symbol": 1,
    "cooldown_after_exit_seconds": 30,
    "slippage_bps": 3,
    "order_type": "MARKET"
  },

  "whale_tracker": {
    "enabled": true,
    "min_capital": 5.0,
    "max_capital_pct": 0.40,
    "depth_window_ms": 1000,
    "order_book_depth": 50,
    "whale_size_min_usdc": 5000,
    "whale_size_min_quote": 5000,
    "whale_multiplier_median": 5.0,
    "whale_multiplier_mean": 3.0,
    "abnormal_volume_std_multiplier": 3.0,
    "bid_ask_imbalance_threshold": 3.0,
    "max_positions_per_symbol": 2,
    "take_profit_bps": 20,
    "stop_loss_bps": 15,
    "max_hold_seconds": 180,
    "cooldown_after_exit_seconds": 20,
    "cooldown_on_same_side_seconds": 60,
    "slippage_bps": 5,
    "trade_timeout_ms": 5000,
    "min_capital_per_trade": 10.0,
    "position_size_pct": 0.30
  },

  "news_reactor": {
    "enabled": true,
    "min_capital": 5.0,
    "max_capital_pct": 0.50,
    "sentiment_threshold_bullish": 0.6,
    "sentiment_threshold_bearish": -0.6,
    "sentiment_consecutive_readings": 2,
    "sentiment_window_minutes": 5,
    "take_profit_bps": 50,
    "stop_loss_bps": 30,
    "max_hold_seconds": 600,
    "cooldown_after_trade_seconds": 300,
    "slippage_bps": 10,
    "max_positions_per_symbol": 1,
    "position_size_pct": 0.25,
    "twitter_check_interval_s": 15,
    "news_feed_check_interval_s": 30,
    "symbol_keywords": {
      "SOLUSDC": ["solana", "sol", "sbf", "solana ecosystem", "solana etf", "solana nft"],
      "ADAUSDC": ["cardano", "ada", "charles hoskinson", "cardano governance", "ada etf"],
      "DOGEUSDC": ["dogecoin", "doge", "elon musk", "doge twitter", "doge coinbase", "dogecoin tweet"]
    },
    "keyword_weights": {
      "elon musk": 3.0,
      "fed": 2.5,
      "sec": 2.5,
      "crash": 2.0,
      "moon": 1.5,
      "pump": 1.5,
      "dump": 2.0
    },
    "whale_alert_threshold": 1000000,
    "max_news_sources": 5
  },

  "logging": {
    "level": "INFO",
    "file": "logs/denaro_war.log",
    "max_bytes": 10485760,
    "backup_count": 10,
    "json_format": true,
    "metrics_file": "logs/metrics.csv"
  },

  "risk": {
    "max_open_positions_total": 6,
    "max_open_positions_per_symbol": 2,
    "cooldown_on_any_loss_seconds": 60,
    "cooldown_on_consecutive_losses": 300,
    "consecutive_loss_limit": 3,
    "pause_on_circuit_break": true,
    "emergency_exit_on_drawdown": true,
    "max_correlation_exposure": 0.5
  },

  "performance": {
    "metrics_calculate_interval_s": 60,
    "sharpe_risk_free_rate": 0.02,
    "sharpe_periods_per_year": 525600,
    "max_records_in_memory": 100000
  }
}
